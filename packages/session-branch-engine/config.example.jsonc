{
  // Observe-only rollout example
  "plugins": {
    "slots": {
      "contextEngine": "session-branch-engine"
    },
    "entries": {
      "session-branch-engine": {
        "enabled": true,
        "softThreshold": 0.6,
        "flushThreshold": 0.75,
        "emergencyThreshold": 0.85,
        "observeOnly": true,
        "memoryOwn": {
          "enabled": true,
          "mode": "async",
          "apiBase": "http://127.0.0.1:8788",
          "disableHttp": false
        }
      }
    }
  }
}
